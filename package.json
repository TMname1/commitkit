{
  "name": "@tmname1/commitslice",
  "version": "1.0.0",
  "description": "Split large git diffs into Conventional Commits, with the opencommit (oco) commit-message generator bundled in the same package.",
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "conventional-commits",
    "diff",
    "split",
    "ai",
    "ollama",
    "opencommit",
    "aicommit",
    "gptcommit"
  ],
  "type": "module",
  "license": "MIT",
  "author": "TMname1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMname1/commitkit.git"
  },
  "main": "commitslice/dist/commitslice.js",
  "bin": {
    "commitslice": "commitslice/dist/commitslice.js",
    "opencommit": "opencommit/out/cli.cjs",
    "oco": "opencommit/out/cli.cjs"
  },
  "files": [
    "commitslice/dist/commitslice.js",
    "opencommit/out/cli.cjs",
    "opencommit/out/tiktoken_bg.wasm",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "commitslice": "node commitslice/src/index.js",
    "oco": "node opencommit/out/cli.cjs",
    "build": "node scripts/build.js",
    "build:opencommit": "node scripts/build.js opencommit",
    "build:commitslice": "node scripts/build.js commitslice",
    "test": "node scripts/test.js",
    "test:commitslice": "node scripts/test.js commitslice",
    "test:oco": "node scripts/test.js oco",
    "test:oco:e2e": "node scripts/test.js oco-e2e",
    "test:oco:docker": "docker build -t commitkit-test -f opencommit/test/Dockerfile . && docker run --rm commitkit-test npm run test:oco",
    "test:oco:e2e:docker": "docker build -t commitkit-test -f opencommit/test/Dockerfile . && docker run --rm commitkit-test npm run test:oco:e2e",
    "lint": "cd opencommit && npx biome check . --diagnostic-level=error && npx tsc --noEmit",
    "typecheck": "cd opencommit && npx tsc --noEmit",
    "format": "cd opencommit && npx prettier --write \"src/**/*.{ts,js,json,md}\" \"test/**/*.{ts,js,json,md}\" \"*.{js,json,ts,md,yml,yaml}\"",
    "format:check": "cd opencommit && npx prettier --check \"src/**/*.{ts,js,json,md}\" \"test/**/*.{ts,js,json,md}\" \"*.{js,json,ts,md,yml,yaml}\""
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.2"
  },
  "devDependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^8.0.1",
    "@anthropic-ai/sdk": "^0.19.2",
    "@azure/openai": "^1.0.0-beta.12",
    "@biomejs/biome": "2.4.11",
    "@clack/prompts": "^0.6.1",
    "@commitlint/types": "^17.4.4",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.3.5",
    "@octokit/webhooks-schemas": "^6.11.0",
    "@octokit/webhooks-types": "^6.11.0",
    "@types/ini": "^1.3.31",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "axios": "1.20.0",
    "chalk": "^5.2.0",
    "cleye": "^1.3.2",
    "cli-testing-library": "^2.0.2",
    "dotenv": "^16.0.3",
    "esbuild": "^0.25.5",
    "execa": "^7.0.0",
    "https-proxy-agent": "^8.0.0",
    "ignore": "^5.2.4",
    "ini": "^3.0.1",
    "inquirer": "^9.3.8",
    "jest": "^30.5.2",
    "openai": "^4.57.0",
    "prettier": "3.9.10",
    "punycode": "^2.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "whatwg-url": "^14.0.0",
    "minimatch": "^11.0.1",
    "glob": "^14.0.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "@octokit/request": {
      "content-type": "^2.1.0"
    }
  }
}
